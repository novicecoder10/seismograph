# Phase 1 needs no credentials: every data source is public and CORS-open.
#
# Phase 1b (Supabase ingestion and Realtime):
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
#
# Phase 7 (LLM analyst, bring your own key, server-side only, never exposed).
# Put these in .env.local (git-ignored). Without a key the explainer uses its
# deterministic template, which is complete on its own. Providers are tried in
# this order, free first; any that fails passes to the next.
#
# OpenRouter: only the ":free" model ids below are used, which cost nothing.
# (Free endpoints may log prompts; the analyst only ever sends public
# earthquake statistics.)
# OPENROUTER_API_KEY=
# ANALYST_OPENROUTER_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,nvidia/nemotron-3-super-120b-a12b:free
#
# Google Gemini (AI Studio key; free tier unless billing is enabled on its project):
# GEMINI_API_KEY=            # or GOOGLE_API_KEY
# ANALYST_GEMINI_MODEL=gemini-2.5-flash
#
# Anthropic:
# ANTHROPIC_API_KEY=
# ANALYST_MODEL=claude-sonnet-5
#
# ANALYST_MAX_PER_HOUR=30    # spend guard: model calls per hour per server
# ANALYST_OFF=1              # set by the test suite: no model calls at all
